#include <windows.h>
#include "version.h"

101 ICON "kingdom-hearts-358-2-days-pragmicat-mix-icon.ico"

#ifndef PRAGMICAT_PLUGIN
1 RT_MANIFEST "launcher.manifest"
#endif

1 VERSIONINFO
FILEVERSION PRAGMICAT_VERSION_NUM
PRODUCTVERSION PRAGMICAT_VERSION_NUM
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
#ifdef PRAGMICAT_PLUGIN
FILETYPE VFT_DLL
#else
FILETYPE VFT_APP
#endif
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "ProductName", "Kingdom Hearts 358/2 Days: Pragmicat Mix\0"
            VALUE "ProductVersion", PRAGMICAT_VERSION_STRING "\0"
            VALUE "FileVersion", PRAGMICAT_VERSION_STRING "\0"
#ifdef PRAGMICAT_PLUGIN
            VALUE "FileDescription", "Kingdom Hearts 358/2 Days: Pragmicat Mix combat mod\0"
            VALUE "OriginalFilename", "pragmicat_mix.dll\0"
#else
            VALUE "FileDescription", "Kingdom Hearts 358/2 Days: Pragmicat Mix launcher\0"
            VALUE "OriginalFilename", "Kingdom Hearts 358-2 Days - Pragmicat Mix.exe\0"
#endif
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
