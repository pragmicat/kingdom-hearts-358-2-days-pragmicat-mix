diff --git a/port/runtime/core/browser_counter.h b/port/runtime/core/browser_counter.h
new file mode 100644
index 0000000..371d4eb
--- /dev/null
+++ b/port/runtime/core/browser_counter.h
@@ -0,0 +1,48 @@
+#ifndef KHDAYS_BROWSER_COUNTER_H
+#define KHDAYS_BROWSER_COUNTER_H
+
+#include <emscripten.h>
+#include <stdint.h>
+
+/* These clock and scalar operations run on the same cooperative thread as
+ * the browser's game and input. Keep each operation free of suspension. */
+typedef int32_t LONG;
+typedef int64_t LONGLONG;
+typedef struct {
+    int64_t QuadPart;
+} LARGE_INTEGER;
+
+static inline void QueryPerformanceCounter(LARGE_INTEGER *value)
+{
+    value->QuadPart = (int64_t)(emscripten_get_now() * 1000000.0);
+}
+
+static inline void QueryPerformanceFrequency(LARGE_INTEGER *value)
+{
+    value->QuadPart = INT64_C(1000000000);
+}
+
+static inline LONG InterlockedExchange(volatile LONG *address, LONG value)
+{
+    const LONG old = *address;
+    *address = value;
+    return old;
+}
+
+static inline LONG InterlockedCompareExchange(volatile LONG *address, LONG value, LONG expected)
+{
+    const LONG old = *address;
+    if (old == expected) {
+        *address = value;
+    }
+    return old;
+}
+
+static inline LONG InterlockedIncrement(volatile LONG *address)
+{
+    const LONG next = (LONG)((uint32_t)*address + 1u);
+    *address = next;
+    return next;
+}
+
+#endif
