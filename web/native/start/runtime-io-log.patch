diff --git a/port/runtime/core/session_log.c b/port/runtime/core/session_log.c
index 3d833e6..e7a063c 100644
--- a/port/runtime/core/session_log.c
+++ b/port/runtime/core/session_log.c
@@ -6,6 +6,119 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+
+#if defined(KHDAYS_BROWSER)
+#include <emscripten.h>
+
+/* The cooperative host writes diagnostics to its local console. Keep the
+ * existing opt-in setting without growing files in the persistent save mount. */
+static size_t remaining_bytes = 2u * 1024u * 1024u;
+static double started_ms;
+static u32 frame;
+static u32 marks;
+static int enabled;
+static int wanted;
+static int opened_for_setting;
+
+static void open_now(void)
+{
+    if (remaining_bytes != 0) {
+        started_ms = emscripten_get_now();
+        enabled = 1;
+    }
+}
+
+void khdays_log_open(void)
+{
+    const char *setting = getenv("KHDAYS_LOG");
+    int on = wanted;
+#if defined(_DEBUG)
+    on = on || setting == NULL || strcmp(setting, "0") != 0;
+#else
+    on = on || (setting != NULL && strcmp(setting, "1") == 0);
+#endif
+    if (on && !enabled) {
+        open_now();
+        opened_for_setting = 0;
+    }
+}
+
+void khdays_log_want(int on)
+{
+    wanted = on != 0;
+    if (wanted && !enabled) {
+        open_now();
+        opened_for_setting = enabled;
+    } else if (!wanted && opened_for_setting) {
+        khdays_log_close();
+        opened_for_setting = 0;
+    }
+}
+
+int khdays_log_on(void)
+{
+    return enabled;
+}
+
+void khdays_log_frame(u32 value)
+{
+    frame = value;
+}
+
+void khdays_log(const char *format, ...)
+{
+    char message[960];
+    char line[1024];
+    va_list args;
+    if (!enabled) {
+        return;
+    }
+    va_start(args, format);
+    const int written = vsnprintf(message, sizeof(message), format, args);
+    va_end(args);
+    if (written < 0) {
+        return;
+    }
+    int result = snprintf(line, sizeof(line), "%9.3f f%-6u %s\n",
+                          (emscripten_get_now() - started_ms) / 1000.0, frame, message);
+    if (result < 0 || (size_t)result >= sizeof(line)) {
+        return;
+    }
+    const size_t size = (size_t)result;
+    if (size <= remaining_bytes) {
+        remaining_bytes -= size;
+        fputs(line, stderr);
+    } else {
+        remaining_bytes = 0;
+    }
+    if (remaining_bytes == 0) {
+        enabled = 0;
+        fputs("khdays-browser: session log limit reached\n", stderr);
+    }
+}
+
+void khdays_log_mark(void)
+{
+    if (enabled) {
+        khdays_log("mark %u (F12)", ++marks);
+        fflush(stderr);
+    }
+}
+
+u32 khdays_log_marks(void)
+{
+    return marks;
+}
+
+void khdays_log_close(void)
+{
+    if (enabled) {
+        enabled = 0;
+        fflush(stderr);
+    }
+}
+
+#else
 #include <windows.h>
 
 static FILE *file;
@@ -190,3 +303,4 @@ void khdays_log_close(void)
