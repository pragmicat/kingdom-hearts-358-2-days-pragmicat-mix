+
+void khdays_diag_callers(char *out, int size, int skip)
+{
+    char stack[4096];
+    if (out == NULL || size <= 0) {
+        return;
+    }
+    out[0] = '\0';
+    if (emscripten_get_callstack(EM_LOG_C_STACK | EM_LOG_NO_PATHS, stack, sizeof(stack)) <= 0) {
+        return;
+    }
+    const char *line = stack;
+    /* Drop this function's frame and the additional callers requested. */
+    for (int i = 0; i <= skip && *line; ++i) {
+        const char *end = strchr(line, '\n');
+        line = end != NULL ? end + 1 : line + strlen(line);
+    }
+    size_t used = 0;
+    while (*line && used < (size_t)size - 1) {
+        while (*line == ' ' || *line == '\t') {
+            ++line;
+        }
+        const char *end = strchr(line, '\n');
+        const size_t len = end != NULL ? (size_t)(end - line) : strlen(line);
+        if (len != 0) {
+            int written = snprintf(out + used, (size_t)size - used, "%s%.*s",
+                                   used != 0 ? " < " : "", (int)len, line);
+            if (written < 0 || (size_t)written >= (size_t)size - used) {
+                return;
+            }
+            used += (size_t)written;
+        }
+        line += len + (end != NULL);
+    }
+}
