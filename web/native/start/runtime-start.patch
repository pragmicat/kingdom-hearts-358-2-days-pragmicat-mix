+static const char *symbol_name(const void *address)
+{
+    static char name[32];
+    if (address == NULL) {
+        return "-";
+    }
+    snprintf(name, sizeof(name), "wasm@%p", address);
+    return name;
+}
+
+const char *khdays_diag_function_at(const void *address)
+{
