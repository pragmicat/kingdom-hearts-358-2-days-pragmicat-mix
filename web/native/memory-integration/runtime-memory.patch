diff --git a/port/runtime/core/memory_browser.inc b/port/runtime/core/memory_browser.inc
new file mode 100644
index 0000000..a73c0e6
--- /dev/null
+++ b/port/runtime/core/memory_browser.inc
@@ -0,0 +1,245 @@
+/* Emscripten has one linear address space. Keep a compact table of the
+ * recompilation's DS ranges and allocate only their backing stores. Aliases
+ * share their canonical RAM allocation. The DS-mode heaps stay in main RAM. */
+#include "enemy_overlays.h"
+#include "io.h"
+#include "runtime.h"
+#include "window.h"
+#include "../../host/app/context.h"
+#include "khdays_data_area.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define GRANULE 0x10000u
+#define MAIN_RAM 0x02000000u
+#define MAIN_RAM_SIZE 0x400000u
+#define DTCM_BASE 0x027e0000u
+#define STACKS_BASE 0x0c000000u
+#define STACKS_END 0x1c000000u
+#define MAX_RANGES (32u + (STACKS_END - STACKS_BASE) / (2u * GRANULE))
+
+typedef struct {
+    unsigned base, size;
+    unsigned char *host;
+    int alias;
+    int stack;
+    int released;
+} MemoryRange;
+
+static MemoryRange ranges[MAX_RANGES];
+static MemoryRange *pages[STACKS_END / GRANULE];
+static unsigned range_count;
+static unsigned stacks_next = STACKS_BASE;
+static int mapped;
+
+u8 *khdays_io_host;
+u8 *khdays_io2_host;
+
+void *khdays_window_range(KhdaysRef reference, size_t size)
+{
+    if (size == 0 || reference >= STACKS_END) {
+        return NULL;
+    }
+    const MemoryRange *range = pages[reference / GRANULE];
+    if (range == NULL || range->released) {
+        return NULL;
+    }
+    const unsigned offset = reference - range->base;
+    return size <= range->size - offset ? range->host + offset : NULL;
+}
+
+void *khdays_window_address(KhdaysRef reference)
+{
+    void *host = khdays_window_range(reference, 1);
+    if (host == NULL) {
+        fprintf(stderr, "browser memory: unmapped DS address 0x%08x\n", reference);
+        abort();
+    }
+    return host;
+}
+
+int khdays_window_try_reference(const void *host, KhdaysRef *reference)
+{
+    *reference = 0;
+    if (host == NULL) {
+        return 1;
+    }
+    const uintptr_t address = (uintptr_t)host;
+    for (unsigned i = 0; i < range_count; ++i) {
+        const MemoryRange *range = &ranges[i];
+        const uintptr_t start = (uintptr_t)range->host;
+        if (!range->alias && !range->released && address >= start && address - start < range->size) {
+            *reference = range->base + (unsigned)(address - start);
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int free_span(unsigned base, unsigned size)
+{
+    if (base == 0 || size == 0 || base >= STACKS_END || size > STACKS_END - base ||
+        base % GRANULE != 0 || size % GRANULE != 0 || range_count == MAX_RANGES) {
+        return 0;
+    }
+    for (unsigned page = base / GRANULE; page < (base + size) / GRANULE; ++page) {
+        if (pages[page] != NULL) {
+            return 0;
+        }
+    }
+    return 1;
+}
+
+static MemoryRange *install(unsigned base, unsigned size, unsigned char *host, int alias)
+{
+    MemoryRange *range = &ranges[range_count++];
+    *range = (MemoryRange){.base = base, .size = size, .host = host, .alias = alias};
+    for (unsigned page = base / GRANULE; page < (base + size) / GRANULE; ++page) {
+        pages[page] = range;
+    }
+    return range;
+}
+
+/* Match the native Windows plain() alignment and preserve its padding. */
+static MemoryRange *plain(unsigned base, unsigned size)
+{
+    const uint64_t end = ((uint64_t)base + size + GRANULE - 1) & ~(uint64_t)(GRANULE - 1);
+    base &= ~(GRANULE - 1);
+    if (end > STACKS_END || end <= base || !free_span(base, (unsigned)(end - base))) {
+        return NULL;
+    }
+    size = (unsigned)(end - base);
+    /* Emscripten malloc need not satisfy the context adapter's 16-byte alignment. */
+    unsigned char *host = aligned_alloc(16, size);
+    if (host == NULL) {
+        return NULL;
+    }
+    memset(host, 0, size);
+    return install(base, size, host, 0);
+}
+
+static int mirror(unsigned base, unsigned canonical, unsigned size)
+{
+    unsigned char *storage = khdays_window_range(canonical, size);
+    if (storage == NULL || !free_span(base, size)) {
+        return 0;
+    }
+    install(base, size, storage, 1);
+    return 1;
+}
+
+static unsigned rounded_stack_size(size_t size)
+{
+    if (size == 0 || size > STACKS_END - STACKS_BASE - GRANULE) {
+        return 0;
+    }
+    return ((unsigned)size + GRANULE - 1) & ~(GRANULE - 1);
+}
+
+static void *window_stack(size_t size)
+{
+    const unsigned rounded = rounded_stack_size(size);
+    if (rounded == 0) {
+        return NULL;
+    }
+    for (unsigned i = 0; i < range_count; ++i) {
+        MemoryRange *range = &ranges[i];
+        if (range->stack && range->released && range->size == rounded) {
+            range->released = 0;
+            return range->host;
+        }
+    }
+    /* Preserve an unmapped DS granule under each stack. In Wasm this is a
+     * translation check, not a host guard page. */
+    if (STACKS_END - stacks_next < GRANULE + rounded) {
+        return NULL;
+    }
+    MemoryRange *range = plain(stacks_next + GRANULE, rounded);
+    if (range == NULL) {
+        return NULL;
+    }
+    range->stack = 1;
+    stacks_next = range->base + range->size;
+    return range->host;
+}
+
+static void window_stack_release(void *stack, size_t size)
+{
+    const unsigned rounded = rounded_stack_size(size);
+    for (unsigned i = 0; i < range_count; ++i) {
+        MemoryRange *range = &ranges[i];
+        if (range->stack && !range->released && range->host == stack && range->size == rounded) {
+            range->released = 1;
+            return;
+        }
+    }
+    fprintf(stderr, "browser memory: unowned or duplicate context stack release\n");
+    abort();
+}
+
+void khdays_memory_unmap(void)
+{
+    khdays_context_stack_source(NULL, NULL);
+    for (unsigned i = 0; i < range_count; ++i) {
+        if (!ranges[i].alias) {
+            free(ranges[i].host);
+        }
+    }
+    memset(pages, 0, sizeof(pages));
+    range_count = 0;
+    stacks_next = STACKS_BASE;
+    khdays_io_host = khdays_io2_host = NULL;
+    mapped = 0;
+}
+
+unsigned long long khdays_heaps_committed(void)
+{
+    return 0; /* The expanded PC heaps are not mapped. */
+}
+
+int khdays_heaps_touched(KhdaysRef reference, unsigned *rest)
+{
+    *rest = GRANULE - reference % GRANULE;
+    return 0;
+}
+
+void khdays_heaps_reset(void)
+{
+    /* The reset path clears the DS main RAM where both browser heaps live. */
+}
+
+int khdays_memory_map(void)
+{
+    if (mapped) {
+        return 1;
+    }
+    if (!(plain(MAIN_RAM, MAIN_RAM_SIZE) &&
+          mirror(0x02400000u, MAIN_RAM, DTCM_BASE - 0x02400000u) &&
+          mirror(0x027f0000u, 0x023f0000u, GRANULE) &&
+          mirror(0x02800000u, MAIN_RAM, MAIN_RAM_SIZE) &&
+          mirror(0x02c00000u, MAIN_RAM, MAIN_RAM_SIZE) &&
+          plain(0x01ff8000u, 0x8000u) && plain(DTCM_BASE, 0x4000u) &&
+          plain(0x03000000u, 0x8000u) && plain(0x037f8000u, 0x18000u) &&
+          plain(0x05000000u, 0x800u) && plain(0x06000000u, 0x008a4000u) &&
+          plain(0x07000000u, 0x800u) && plain(0x08000000u, GRANULE) &&
+          mirror(0x0a000000u, 0x08000000u, GRANULE) &&
+          plain(KHDAYS_IO_VIEW, KHDAYS_IO_SIZE + KHDAYS_IO2_SIZE) &&
+          (KHDAYS_DATA_AREA_END == KHDAYS_DATA_AREA ||
+           plain(KHDAYS_DATA_AREA, KHDAYS_DATA_AREA_END - KHDAYS_DATA_AREA)) &&
+          plain(KHDAYS_ENEMY_OVERLAYS,
+                (KHDAYS_ENEMY_OVERLAY_LAST - KHDAYS_ENEMY_OVERLAY_FIRST + 1) * KHDAYS_ENEMY_OVERLAY_SPAN) &&
+          plain(KHDAYS_ENEMY_HANDLERS, KHDAYS_ENEMY_SLOTS_END - KHDAYS_ENEMY_HANDLERS))) {
+        khdays_memory_unmap();
+        fprintf(stderr, "browser memory: could not allocate the native DS memory layout\n");
+        return 0;
+    }
+    memset(KHDAYS_W(0x08000000u), 0xff, GRANULE);
+    khdays_io_host = KHDAYS_W(KHDAYS_IO_VIEW);
+    khdays_io2_host = KHDAYS_W(KHDAYS_IO2_VIEW);
+    khdays_context_stack_source(window_stack, window_stack_release);
+    mapped = 1;
+    return 1;
+}
