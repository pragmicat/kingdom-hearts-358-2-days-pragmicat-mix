diff --git a/port/host/net/net_browser.c b/port/host/net/net_browser.c
new file mode 100644
index 0000000..c3ec42d
--- /dev/null
+++ b/port/host/net/net_browser.c
@@ -0,0 +1,132 @@
+/* An offline browser host. The native wireless protocol requires raw IPv4
+ * sockets. Reject startup before it can create a session or its worker. */
+#include "net.h"
+
+#include <emscripten.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/random.h>
+
+int khdays_host_net_start(void)
+{
+    static int reported;
+    if (!reported) {
+        fputs("khdays-browser: wireless multiplayer is unavailable\n", stderr);
+        reported = 1;
+    }
+    return 0;
+}
+
+KhdaysUdp *khdays_host_udp_open(unsigned short port, int shared)
+{
+    (void)port;
+    (void)shared;
+    return NULL;
+}
+
+unsigned short khdays_host_udp_port(const KhdaysUdp *udp)
+{
+    (void)udp;
+    return 0;
+}
+
+int khdays_host_udp_join(KhdaysUdp *udp, unsigned int group)
+{
+    (void)udp;
+    (void)group;
+    return 0;
+}
+
+int khdays_host_udp_send(KhdaysUdp *udp, const KhdaysNetAddress *to, const void *data, size_t size)
+{
+    (void)udp;
+    (void)to;
+    (void)data;
+    (void)size;
+    return 0;
+}
+
+long khdays_host_udp_receive(KhdaysUdp *udp, KhdaysNetAddress *from, void *data, size_t room)
+{
+    (void)udp;
+    (void)from;
+    (void)data;
+    (void)room;
+    return -1;
+}
+
+void khdays_host_udp_wait(KhdaysUdp *const *udps, int count, int ms)
+{
+    /* No socket can be opened and no receiver is started. */
+    (void)udps;
+    (void)count;
+    (void)ms;
+}
+
+void khdays_host_udp_close(KhdaysUdp *udp)
+{
+    (void)udp;
+}
+
+int khdays_host_net_addresses(unsigned int *ips, int room)
+{
+    (void)ips;
+    (void)room;
+    return 0;
+}
+
+int khdays_host_net_resolve(const char *text, unsigned short port, KhdaysNetAddress *out)
+{
+    (void)text;
+    (void)port;
+    (void)out;
+    return 0;
+}
+
+unsigned int khdays_host_build_identity(void)
+{
+    return 0; /* unavailable without transport */
+}
+
+void khdays_host_random(void *data, size_t size)
+{
+    unsigned char *next = data;
+    while (size != 0) {
+        const size_t chunk = size > 256 ? 256 : size;
+        if (getentropy(next, chunk) != 0) {
+            fputs("khdays-browser: system randomness is unavailable\n", stderr);
+            abort();
+        }
+        next += chunk;
+        size -= chunk;
+    }
+}
+
+unsigned long long khdays_host_net_clock_ms(void)
+{
+    return (unsigned long long)emscripten_get_now();
+}
+
+long khdays_host_tcp_exchange(const KhdaysNetAddress *to, const void *request, size_t size,
+                              void *reply, size_t room, int ms, unsigned int *local)
+{
+    (void)to;
+    (void)request;
+    (void)size;
+    (void)reply;
+    (void)room;
+    (void)ms;
+    (void)local;
+    return -1;
+}
+
+int khdays_host_net_gateway(unsigned int *ip)
+{
+    (void)ip;
+    return 0;
+}
+
+unsigned long long khdays_host_physical_memory(void)
+{
+    return 0;
+}
