@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+"""Emit typed metadata tables after all game C has been rewritten.
+
+Targets stay behind the original globally visible records in their owning TUs;
+private initializer/function targets never need new external linkage. Source
+and declaration order is retained, including overlapping data initializers.
+"""
+from __future__ import annotations
+
+import argparse
+from dataclasses import dataclass
+from pathlib import Path
+import re
+from typing import Iterable
+
+
+NOISE = re.compile(r'//[^\n]*|/\*.*?\*/|"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'', re.DOTALL)
+RECORD = re.compile(
+    r"\b(?P<const>const\s+)?struct\s+"
+    r"(?P<kind>khdays_data_init|khdays_function_record|khdays_route_record)\s+"
+    r"(?P<symbol>[A-Za-z_][A-Za-z_0-9]*)\s*=\s*\{"
+)
+KINDS = {
+    "khdays_data_init": ("data", "data", False),
+    "khdays_function_record": ("functions", "function", True),
+    "khdays_route_record": ("routes", "route", True),
+}
+
+
+@dataclass(frozen=True)
+class Record:
+    kind: str
+    symbol: str
+    source: Path
+
+
+def records_in(source: Path) -> list[Record]:
+    text = source.read_text(encoding="utf-8")
+    clean = NOISE.sub(lambda match: "\n" * match.group().count("\n") + " ", text)
+    found = []
+    depth = 0
+    previous = 0
+    for match in RECORD.finditer(clean):
+        before = clean[previous:match.start()]
+        depth += before.count("{") - before.count("}")
+        if depth != 0:
+            raise ValueError(f"{source}: metadata {match['symbol']} must be globally defined")
+        prefix = before[max(before.rfind(";"), before.rfind("}")) + 1:]
+        if re.search(r"\bstatic\b", prefix):
+            raise ValueError(f"{source}: metadata {match['symbol']} must have external linkage")
+        kind = match["kind"]
+        if bool(match["const"]) != KINDS[kind][2]:
+            qualifier = "const" if KINDS[kind][2] else "mutable"
+            raise ValueError(f"{source}: metadata {match['symbol']} must use its emitted {qualifier} type")
+        found.append(Record(kind, match["symbol"], source))
+        previous = match.end() - 1  # include this initializer's opening brace next time
+    return found
+
+
+def write_registry(sources: Iterable[str | Path], output: str | Path) -> Path:
+    """Write/return C to append to the complete current rewritten source list.
+
+    Use the exact ordered build list, never a directory glob that could include
+    stale output. Retain every original metadata record; repeated numeric
+    function references from different TUs are legitimate.
+    """
+    output = Path(output)
+    paths = list(dict.fromkeys(Path(source).resolve() for source in sources))
+    records: dict[str, Record] = {}
+    for source in paths:
+        if source == output.resolve():
+            raise ValueError("the generated registry cannot be its own input")
+        for record in records_in(source):
+            if record.symbol in records:
+                raise ValueError(f"duplicate metadata symbol {record.symbol}: {records[record.symbol].source}, {source}")
+            records[record.symbol] = record
+    lines = [
+        "/* Generated by port/tools/static_registry.py from the complete ordered rewritten source list. */",
+        '#include "static_registry.h"',
+        "",
+    ]
+    for record in sorted(records.values(), key=lambda item: item.symbol):
+        qualifier = "const " if KINDS[record.kind][2] else ""
+        lines.append(f"extern {qualifier}struct {record.kind} {record.symbol};")
+    for kind, (plural, singular, _) in KINDS.items():
+        names = [record.symbol for record in records.values() if record.kind == kind]
+        lines += ["", f"const struct {kind} *const khdays_static_{plural}[] = {{"]
+        lines += [f"    &{name}," for name in names] if names else ["    NULL,"]
+        lines += ["};", f"const size_t khdays_static_{singular}_count = {len(names)}u;"]
+    text = "\n".join(lines) + "\n"
+    output.parent.mkdir(parents=True, exist_ok=True)
+    if not output.exists() or output.read_text(encoding="utf-8") != text:
+        output.write_text(text, encoding="utf-8", newline="\n")
+    return output
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("sources", nargs="*", type=Path)
+    args = parser.parse_args()
+    print(write_registry(args.sources, args.out))
