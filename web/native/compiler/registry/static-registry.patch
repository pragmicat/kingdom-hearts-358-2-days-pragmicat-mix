+/* Explicit metadata tables for builds without Windows COFF enumeration.
+ * The original records stay in their owning translation units, retaining the
+ * linkage of their initializer, function and typed route targets. */
+#ifndef KHDAYS_STATIC_REGISTRY_H
+#define KHDAYS_STATIC_REGISTRY_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Defined by decomp_compat.h and retained in rewritten C. Forward declaration
+ * here avoids defining that emitted host structure twice. */
+struct khdays_data_init;
+
+#pragma pack(push, 8)
+struct khdays_function_record {
+    unsigned int reference;
+    void (*function)(void);
+};
+struct khdays_route_record {
+    const char *name;
+    void **route;
+    void *body;
+    void *unused;
+};
+#pragma pack(pop)
+
+/* Empty registries have one physical NULL slot and an explicit zero count.
+ * Arrays always point to the actual named record types, without layout casts. */
+extern const struct khdays_data_init *const khdays_static_data[];
+extern const size_t khdays_static_data_count;
+extern const struct khdays_function_record *const khdays_static_functions[];
+extern const size_t khdays_static_function_count;
+extern const struct khdays_route_record *const khdays_static_routes[];
+extern const size_t khdays_static_route_count;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
