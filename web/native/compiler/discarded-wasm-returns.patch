diff --git a/port/tools/references/wasm_abi.py b/port/tools/references/wasm_abi.py
index 2dba03c..a3e939c 100644
--- a/port/tools/references/wasm_abi.py
+++ b/port/tools/references/wasm_abi.py
@@ -184,6 +184,31 @@ def mismatched_returns(found, game_functions: set[str]) -> list[str]:
     return mismatched
 
 
+def discarded_return_classes(found, game_functions: set[str]) -> dict[str, str]:
+    """Exact defined result classes for scalar/void mismatch candidates.
+
+    This is only a plan: emit.py must prove each mismatched call discards its
+    result, and reject mismatched address-taking. Used wrong-class values and
+    aggregate returns cannot be repaired by changing a call's C signature.
+    """
+    entries: dict[str, list] = {}
+    for _, _, _, shapes, _ in found:
+        for name, records in shapes.items():
+            entries.setdefault(name, []).extend(records)
+    direct = {"void", "i32", "i64", "f32", "f64"}
+    plan = {}
+    for name, records in entries.items():
+        if name not in game_functions:
+            continue
+        if any(len(entry) < 4 for entry in records):
+            raise UnsupportedWasmABI(None, f"wasm32 ABI: missing return-class metadata for {name}")
+        defined = {entry[3] for entry in records if entry[0] == "def"}
+        classes = {entry[3] for entry in records}
+        if len(defined) == 1 and len(classes) > 1 and classes <= direct:
+            plan[name] = next(iter(defined))
+    return plan
+
+
 def block_abi(found, game_functions: set[str]) -> set[str]:
     """Wasm needs exact arity/classes; matching prefixes are insufficient."""
     entries: dict[str, list] = {}
diff --git a/port/tools/references_wasm_returns_test.py b/port/tools/references_wasm_returns_test.py
new file mode 100644
index 0000000..0ef151c
--- /dev/null
+++ b/port/tools/references_wasm_returns_test.py
@@ -0,0 +1,117 @@
+"""Bounded discarded-return repair in the real rewrite and optional Wasm link.
+
+python port/tools/references_wasm_returns_test.py
+KHDAYS_TEST_EMCC=/path/emcc python port/tools/references_wasm_returns_test.py
+"""
+from pathlib import Path
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from references import rewrite_text
+from references.build import _index_key
+from references.emit import EmitFailure, Index
+from references.wasm_abi import discarded_return_classes, mismatched_returns
+
+
+class DiscardedReturns(unittest.TestCase):
+    def rewrite(self, source, result="void", **kwargs):
+        return rewrite_text(source, "src/caller.c", Index(
+            game_functions={"target", "caller"}, discarded_returns={"target": result}, **kwargs))
+
+    def test_definition_plan_does_not_relax_aggregate_or_missing_metadata(self):
+        shapes = {"target": [["def", [], False, "void"], ["decl", [], False, "i32"]],
+                  "aggregate": [["def", [], True, "sret:8:4"], ["decl", [], False, "i64"]]}
+        found = [("source.c", [], [], shapes, "")]
+        self.assertEqual(discarded_return_classes(found, set(shapes)), {"target": "void"})
+        self.assertEqual(mismatched_returns(found, {"aggregate"}), ["aggregate (defined sret:8:4)"])
+
+    def test_exact_definition_classes_for_discarded_calls(self):
+        for result, spelling in [("void", "void"), ("i32", "int"), ("i64", "long long"),
+                                 ("f32", "float"), ("f64", "double")]:
+            declared = "int" if result == "void" else "void"
+            with self.subTest(result=result):
+                output = self.rewrite(f"extern {declared} target(void); void caller(void){{target();}}", result)
+                self.assertIn(f"extern {spelling} target(void);", output)
+                self.assertIn("((void)(target()))", output)
+
+    def test_scalar_wrong_class_can_only_be_discarded(self):
+        output = self.rewrite("extern double target(void); void caller(void){target();}", "i32")
+        self.assertIn("extern int target(void);", output)
+        with self.assertRaisesRegex(EmitFailure, "used return value"):
+            self.rewrite("extern double target(void); double caller(void){return target();}", "i32")
+
+    def test_same_tu_definition_keeps_its_real_scalar_spelling(self):
+        output = self.rewrite("extern void target(void); void caller(void){target();}"
+                              "unsigned char target(void){return 7;}", "i32")
+        self.assertIn("extern unsigned char target(void);", output)
+        self.assertIn("unsigned char target(void)", output)
+
+    def test_statement_void_cast_comma_and_loop_discard_proofs(self):
+        for statement in ["target();", "(void)target();", "(target(), 0);",
+                          "if (1) target();", "for(target(); 0; target()) {}"]:
+            with self.subTest(statement=statement):
+                self.rewrite("extern int target(void); void caller(void){" + statement + "}")
+
+    def test_values_and_function_arguments_remain_errors(self):
+        for body in ["return target();", "int x=target(); return x;", "return target()+1;",
+                     "if(target()) return 1; return 0;", "return other(target(), 0);"]:
+            with self.subTest(body=body), self.assertRaisesRegex(EmitFailure, "used return value"):
+                self.rewrite("extern int target(void); extern int other(int,int); int caller(void){"+body+"}")
+
+    def test_mismatched_function_pointer_is_not_reinterpreted(self):
+        with self.assertRaisesRegex(EmitFailure, "taken by address"):
+            self.rewrite("extern int target(void); void caller(void){int (*p)(void)=target;}")
+        with self.assertRaisesRegex(EmitFailure, "taken by address"):
+            self.rewrite("extern int target; void caller(void){int *p=&target;}", game_objects=set())
+
+    def test_dispatched_call_and_argument_block_keep_exact_result(self):
+        output = self.rewrite("extern int target(int); void caller(void){target(7);}",
+                              dispatched={"target": 0x02001000})
+        self.assertIn("void(*)(int)", output)
+        output = self.rewrite("extern int target(int); void caller(void){target(7);}",
+                              dispatched={"target": 0x02001000}, variadic={"target"})
+        self.assertIn("void(*)(khdays_ref)", output)
+
+    def test_return_plan_invalidates_emit_cache(self):
+        self.assertNotEqual(_index_key(Index()), _index_key(Index(discarded_returns={"target": "void"})))
+
+    @unittest.skipUnless(os.environ.get("KHDAYS_TEST_EMCC"), "set KHDAYS_TEST_EMCC for pinned Emscripten")
+    def test_actual_cross_tu_wasm_calls(self):
+        emcc = os.environ["KHDAYS_TEST_EMCC"]
+        scalar = [("i32", "int", "7"), ("i64", "long long", "7ll"),
+                  ("f32", "float", "7.5f"), ("f64", "double", "7.5")]
+        names = {f"target_{kind}" for kind, _, _ in scalar} | {"target_void", "caller"}
+        plan = {f"target_{kind}": kind for kind, _, _ in scalar} | {"target_void": "void"}
+        callers = "\n".join(f"extern void target_{kind}(void);" for kind, _, _ in scalar)
+        callers += "\nextern long long target_void(void);\nvoid caller(void){"
+        callers += "".join(f"target_{kind}();" for kind, _, _ in scalar) + "target_void();}\n"
+        definitions = "void host_count(void);\n" + "\n".join(
+            f"{spelling} target_{kind}(void){{host_count();return {value};}}" for kind, spelling, value in scalar)
+        definitions += "\nvoid target_void(void){host_count();}\n"
+        index = Index(game_functions=names, discarded_returns=plan)
+        with tempfile.TemporaryDirectory(prefix="days-discard-return-") as temp:
+            folder = Path(temp)
+            (folder/"khdays_references.h").write_text("typedef unsigned int khdays_ref;\n")
+            for name, source in [("callers", callers), ("definitions", definitions)]:
+                (folder/(name+".c")).write_text(rewrite_text(source, "src/"+name+".c", index))
+            (folder/"callers-bad.c").write_text(rewrite_text(callers, "src/callers.c", Index(game_functions=names)))
+            (folder/"main.c").write_text("int count; void host_count(void){++count;} void caller(void);"
+                                         "int main(void){caller();return count==5?0:1;}")
+            result = folder/"test.cjs"
+            common = [emcc, "-std=c17", "-O0", "-I", str(folder), str(folder/"definitions.c"),
+                      str(folder/"main.c"), "-sENVIRONMENT=node", "-sSINGLE_FILE=1",
+                      "-sWASM_ASYNC_COMPILATION=0", "-sEXIT_RUNTIME=1", "-Werror",
+                      "-Wno-unknown-pragmas", "-Wl,--fatal-warnings", "-o", str(result)]
+            baseline = subprocess.run([*common, str(folder/"callers-bad.c")], text=True, capture_output=True)
+            self.assertNotEqual(baseline.returncode, 0)
+            self.assertIn("signature mismatch", baseline.stderr)
+            subprocess.run([*common, str(folder/"callers.c")], check=True)
+            subprocess.run([os.environ.get("KHDAYS_TEST_NODE", "node"), str(result)], check=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
