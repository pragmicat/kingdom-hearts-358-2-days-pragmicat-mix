diff --git a/port/tools/references/wasm_abi.py b/port/tools/references/wasm_abi.py
new file mode 100644
index 0000000..2dba03c
--- /dev/null
+++ b/port/tools/references/wasm_abi.py
@@ -0,0 +1,202 @@
+"""Audited wasm32 C ABI subset for the Days reference rewrite.
+
+Target: Emscripten 4.0.23 / LLVM 5243501cca02d7e54294d4bb5de0a85b06c40b7d,
+ordinary C ABI, game records compiled with -fpack-struct=4. This classifies
+emitted game types, whose pointers become 32-bit references; the game's data
+and argument-block layout does not change.
+
+Primary sources in that LLVM commit: clang/lib/CodeGen/Targets/WebAssembly.cpp
+and clang/lib/CodeGen/ABIInfoImpl.cpp (single-element/default classification).
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from .types import Array, Arithmetic, Enumeration, Function, Pointer, Record, TypeFailure, Void, decayed
+
+
+class UnsupportedWasmABI(TypeFailure):
+    """Stop generation when the modeled layout cannot establish the C ABI."""
+
+
+@dataclass(frozen=True)
+class ValueABI:
+    kind: str  # direct, indirect, ignore
+    scalar: str | None
+    size: int
+    alignment: int  # game record-member alignment, not Wasm stack alignment
+
+    @property
+    def signature(self) -> str:
+        if self.kind == "direct":
+            return self.scalar or "void"
+        return "sret" if self.kind == "indirect" else "void"
+
+
+def _fail(t, message: str):
+    node = t.definition.node if isinstance(t, Record) else None
+    raise UnsupportedWasmABI(node, "wasm32 ABI: " + message)
+
+
+def _array_count(layout, t: Array) -> int:
+    if t.length is None:
+        _fail(t, "a flexible/incomplete array in a by-value record is not supported")
+    count = layout.value(t.length)
+    if count < 0:
+        _fail(t, "a negative array extent is not supported")
+    return count
+
+
+def _validate(layout, t) -> None:
+    if isinstance(t, Arithmetic):
+        if t.spelling == "long double":
+            _fail(t, "long double is 16 bytes on this target, not the game's modeled 8 bytes")
+        if t.spelling not in {
+            "_Bool", "char", "signed char", "unsigned char", "short", "unsigned short",
+            "int", "unsigned int", "long", "unsigned long", "long long", "unsigned long long", "float", "double",
+        }:
+            _fail(t, f"scalar {t.spelling!r} is not classified")
+        return
+    if isinstance(t, Enumeration):
+        # The upstream enum type lacks a link to its declaration. Conservatively
+        # refuse wider enumerators in a TU containing a by-value enum signature.
+        for symbol in layout.tp.file.ordinary.values():
+            if symbol.kind == "enumerator":
+                value = layout.enumerator(symbol)
+                if not -(1 << 31) <= value <= (1 << 32) - 1:
+                    _fail(t, f"wide enumerator {symbol.name} needs an explicit underlying-type model")
+        return
+    if isinstance(t, (Pointer, Void)):
+        return
+    if isinstance(t, Array):
+        _array_count(layout, t)
+        _validate(layout, t.element)
+        return
+    if not isinstance(t, Record):
+        _fail(t, f"a by-value {type(t).__name__} is not classified")
+    definition = t.definition
+    if definition.kind != "struct":
+        _fail(t, f"by-value {definition.kind} {definition.tag or '<anonymous>'} requires an explicit ABI audit")
+    if definition.node is None or definition.fields is None:
+        _fail(t, "an incomplete record has no established ABI")
+    for member, bits in layout.members(definition.node):
+        if bits is not None:
+            _fail(t, f"bit-fields in by-value {definition.spelling or 'struct'} require an explicit ABI audit")
+        _validate(layout, member)
+    layout.measure(t)
+
+
+def _empty(layout, t) -> bool:
+    if isinstance(t, Array):
+        return _array_count(layout, t) == 0 or _empty(layout, t.element)
+    if isinstance(t, Record):
+        return all(_empty(layout, member) for member, _ in layout.members(t.definition.node))
+    return False
+
+
+def _single_scalar(layout, t: Record):
+    members = [member for member, _ in layout.members(t.definition.node) if not _empty(layout, member)]
+    if len(members) != 1:
+        return None
+    member = members[0]
+    while isinstance(member, Array) and _array_count(layout, member) == 1:
+        member = member.element
+    if isinstance(member, Record):
+        member = _single_scalar(layout, member)
+    elif isinstance(member, Array):
+        return None
+    if member is None or layout.size(t) != layout.size(member):
+        return None
+    return member
+
+
+def _scalar(layout, t) -> str:
+    if isinstance(t, Arithmetic) and t.floating:
+        return "f32" if t.spelling == "float" else "f64"
+    return "i64" if layout.size(t) == 8 else "i32"
+
+
+def classify(layout, t) -> ValueABI:
+    """Multi-member records are indirect regardless of size; a single scalar
+    may be direct only without extra padding. Empty C records are ignored.
+    Unions, bit-fields and flexible arrays require a separate audit.
+    """
+    _validate(layout, t)
+    if isinstance(t, (Array, Function)):
+        _fail(t, "an array/function cannot be passed or returned as a C value")
+    if isinstance(t, Void):
+        return ValueABI("ignore", None, 0, 1)
+    size, alignment = layout.measure(t)
+    if isinstance(t, Record):
+        if _empty(layout, t):
+            return ValueABI("ignore", None, size, alignment)
+        member = _single_scalar(layout, t)
+        if member is None:
+            return ValueABI("indirect", None, size, alignment)
+        return ValueABI("direct", _scalar(layout, member), size, alignment)
+    return ValueABI("direct", _scalar(layout, t), size, alignment)
+
+
+def hidden_result(layout, function: Function) -> bool:
+    return classify(layout, function.result).kind == "indirect"
+
+
+def return_signature(layout, function: Function) -> str:
+    """Result class for rejecting direct i32/f32/f64/i64 and sret differences."""
+    value = classify(layout, function.result)
+    return f"sret:{value.size}:{value.alignment}" if value.kind == "indirect" else value.signature
+
+
+def parameter_shape(layout, parameter) -> list:
+    """Conservative ABI class plus the existing DS four-byte word count.
+    Preserve aggregate/scalar distinctions even where their raw class agrees.
+    """
+    parameter = decayed(parameter)
+    value = classify(layout, parameter)
+    aggregate = "s" if isinstance(parameter, Record) else "w"
+    kind = f"{aggregate}:{value.kind}:{value.scalar or '-'}:{value.size}:{value.alignment}"
+    return [kind, (value.size + 3) // 4]
+
+
+def prototype_shape(layout, function: Function) -> list | None:
+    classify(layout, function.result)
+    if function.params is None:
+        return None
+    shape = [parameter_shape(layout, parameter) for parameter in function.params]
+    return shape + [["...", 0]] if function.variadic else shape
+
+
+def mismatched_returns(found, game_functions: set[str]) -> list[str]:
+    """Wasm metadata entries are [kind, arguments, hidden, result-class]."""
+    entries: dict[str, list] = {}
+    for _, _, _, shapes, _ in found:
+        for name, records in shapes.items():
+            entries.setdefault(name, []).extend(records)
+    mismatched = []
+    for name, records in sorted(entries.items()):
+        if name not in game_functions:
+            continue
+        if any(len(entry) < 4 for entry in records):
+            raise UnsupportedWasmABI(None, f"wasm32 ABI: missing return-class metadata for {name}")
+        defined = next((entry[3] for entry in records if entry[0] == "def"), None)
+        if defined is not None and any(entry[3] != defined for entry in records):
+            mismatched.append(f"{name} (defined {defined})")
+    return mismatched
+
+
+def block_abi(found, game_functions: set[str]) -> set[str]:
+    """Wasm needs exact arity/classes; matching prefixes are insufficient."""
+    entries: dict[str, list] = {}
+    for _, _, _, shapes, _ in found:
+        for name, records in shapes.items():
+            entries.setdefault(name, []).extend(records)
+    block = set()
+    for name, records in entries.items():
+        if name not in game_functions:
+            continue
+        defined = next((entry[1] for entry in records if entry[0] == "def"), None)
+        if any(entry[1] is not None and ["...", 0] in entry[1] for entry in records):
+            block.add(name)
+        elif defined is not None and any(entry[1] != defined for entry in records):
+            block.add(name)
+    return block
