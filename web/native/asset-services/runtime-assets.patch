new file mode 100644
index 0000000..e6c59fb
--- /dev/null
+++ b/port/runtime/mods/asset_paths.h
@@ -0,0 +1,40 @@
+/* Local output paths used by the texture and sheet-colour tools. */
+#ifndef KHDAYS_ASSET_PATHS_H
+#define KHDAYS_ASSET_PATHS_H
+
+#include <stddef.h>
+#include <string.h>
+
+#if defined(KHDAYS_BROWSER)
+#include <sys/stat.h>
+#define KHDAYS_ASSET_PATH_MAX 4096
+#else
+#include <windows.h>
+#define KHDAYS_ASSET_PATH_MAX MAX_PATH
+#endif
+
+/* Creates each parent component. Existing directories are harmless. */
+static inline void khdays_asset_make_directories(const char *path)
+{
+    char part[KHDAYS_ASSET_PATH_MAX];
+    if (*path == '\0') {
+        return;
+    }
+    for (size_t i = 1; i < sizeof(part) - 1 && path[i] != '\0'; ++i) {
+#if defined(KHDAYS_BROWSER)
+        if (path[i] == '/') {
+#else
+        if (path[i] == '/' || path[i] == '\\') {
+#endif
+            memcpy(part, path, i);
+            part[i] = '\0';
+#if defined(KHDAYS_BROWSER)
+            mkdir(part, 0777);
+#else
+            CreateDirectoryA(part, NULL);
+#endif
+        }
+    }
+}
+
+#endif
