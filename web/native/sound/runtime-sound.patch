+/* Single-cooperative-thread sound platform for the browser build. The driver,
+ * mixer, callbacks and replacement decoder MUST NOT suspend while a lock is
+ * held. These guards detect re-entry; they are not pthread synchronization. */
+#ifndef KHDAYS_SOUND_BROWSER_PLATFORM_H
+#define KHDAYS_SOUND_BROWSER_PLATFORM_H
+#if !defined(__EMSCRIPTEN__) || defined(__EMSCRIPTEN_PTHREADS__)
+#error This sound host requires single-threaded Emscripten
+#endif
+#include <assert.h>
+#include <stdint.h>
+#include <emscripten.h>
+#include <emscripten/html5.h>
+
+typedef long LONG;
+_Static_assert(sizeof(LONG) == 4, "browser sound expects a 32-bit LONG");
+typedef int64_t LONG64;
+typedef struct { int held; } SRWLOCK;
+#define SRWLOCK_INIT {0}
+static inline void AcquireSRWLockExclusive(SRWLOCK *lock) { assert(!lock->held); lock->held = 1; }
+static inline void ReleaseSRWLockExclusive(SRWLOCK *lock) { assert(lock->held); lock->held = 0; }
+static inline LONG InterlockedExchange(volatile LONG *at, LONG value) { LONG old=*at; *at=value; return old; }
+static inline LONG InterlockedCompareExchange(volatile LONG *at,LONG value,LONG expected) { LONG old=*at; if(old==expected)*at=value; return old; }
+static inline LONG InterlockedIncrement(volatile LONG *at) { *at=(LONG)((uint32_t)*at+1u); return *at; }
+static inline LONG InterlockedDecrement(volatile LONG *at) { *at=(LONG)((uint32_t)*at-1u); return *at; }
+static inline LONG InterlockedOr(volatile LONG *at,LONG bits) { LONG old=*at; *at|=bits; return old; }
+static inline LONG InterlockedAnd(volatile LONG *at,LONG bits) { LONG old=*at; *at&=bits; return old; }
+typedef struct { int64_t QuadPart; } LARGE_INTEGER;
+static inline void QueryPerformanceCounter(LARGE_INTEGER *out) { out->QuadPart=(int64_t)(emscripten_get_now()*1000.0); }
+static inline void QueryPerformanceFrequency(LARGE_INTEGER *out) { out->QuadPart=1000000; }
+#endif
